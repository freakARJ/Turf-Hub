{
  "entities": {
    "Turf": {
      "title": "Turf",
      "description": "A bookable football turf venue with location coordinates, capacity, availability schedule, and pricing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "neighborhood": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "format": {
          "type": "string",
          "enum": ["5v5", "7v7", "11v11"]
        },
        "capacity": {
          "type": "number"
        },
        "surface": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "pricePerHour": {
          "type": "number"
        },
        "openHour": {
          "type": "number"
        },
        "closeHour": {
          "type": "number"
        },
        "openDays": {
          "type": "array"
        },
        "amenities": {
          "type": "array"
        },
        "imageKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "neighborhood",
        "address",
        "lat",
        "lng",
        "format",
        "capacity",
        "surface",
        "pricePerHour",
        "openHour",
        "closeHour",
        "openDays",
        "amenities",
        "imageKey",
        "rating",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "SlotReservation": {
      "title": "SlotReservation",
      "description": "PII-free atomic lock document preventing double bookings on a turf for a given date and start hour.",
      "type": "object",
      "properties": {
        "slotKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "turfId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startHour": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["reserved", "maintenance", "released"]
        },
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slotKey",
        "turfId",
        "date",
        "startHour",
        "status",
        "bookingId",
        "bookedByUid",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed turf reservation and online payment receipt.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "slotKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "turfId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "turfName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "turfFormat": {
          "type": "string",
          "enum": ["5v5", "7v7", "11v11"]
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 24
        },
        "teamName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startHour": {
          "type": "number"
        },
        "durationHours": {
          "type": "number"
        },
        "basePrice": {
          "type": "number"
        },
        "serviceFee": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["bkash", "nagad", "rocket", "card"]
        },
        "paymentReference": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cardLast4": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "refunded"]
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "checked_in", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "bookingCode",
        "slotKey",
        "turfId",
        "turfName",
        "turfFormat",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "teamName",
        "date",
        "startHour",
        "durationHours",
        "basePrice",
        "serviceFee",
        "discountAmount",
        "totalAmount",
        "paymentMethod",
        "paymentReference",
        "cardLast4",
        "paymentStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private player profile containing contact info, avatar, team preferences, and favorite turf IDs.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 24
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 40000
        },
        "preferredPosition": {
          "type": "string",
          "maxLength": 40
        },
        "defaultTeamName": {
          "type": "string",
          "maxLength": 60
        },
        "favoriteTurfIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "phone",
        "photoUrl",
        "preferredPosition",
        "defaultTeamName",
        "favoriteTurfIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminSubscription": {
      "title": "AdminSubscription",
      "description": "Turf owner 3-month free trial and recurring subscription billing state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "planName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "monthlyPrice": {
          "type": "number"
        },
        "trialMonths": {
          "type": "number"
        },
        "trialStartAt": {
          "type": "string",
          "format": "date-time"
        },
        "trialEndsAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["trial_active", "active", "canceled"]
        },
        "billingLast4": {
          "type": "string",
          "maxLength": 8
        },
        "autoRenew": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "planName",
        "monthlyPrice",
        "trialMonths",
        "trialStartAt",
        "trialEndsAt",
        "status",
        "billingLast4",
        "autoRenew",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin access registry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/turfs/{turfId}": {
      "schema": { "$ref": "#/entities/Turf" },
      "description": "Publicly browsable football turf venues managed by administrators."
    },
    "/slotReservations/{slotKey}": {
      "schema": { "$ref": "#/entities/SlotReservation" },
      "description": "Atomic non-PII slot reservation locks keyed by {turfId}_{date}_{startHour}."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Private player turf bookings and payment receipts."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated to the owner and admins."
    },
    "/adminSubscriptions/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminSubscription" },
      "description": "Turf owner 3-month free trial and subscription billing configuration."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin allowlist."
    }
  }
}
